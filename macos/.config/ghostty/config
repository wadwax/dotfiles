# Ghostty configuration
# Docs: https://ghostty.org/docs/config/reference
# Symlinked to ~/.config/ghostty/config by stow (macos package)

theme = TokyoNight

font-family = Hack Nerd Font Mono
font-size = 14

cursor-style = block
cursor-style-blink = false

scrollback-limit = 10000000

# Don't prompt when quitting with running sessions
confirm-close-surface = false
quit-after-last-window-closed = true

macos-option-as-alt = true

# Cmd+T opens a new window instead of a native tab.
# Native tabs show up as separate windows to AeroSpace and break tiling.
keybind = super+t=new_window
keybind = super+w=close_window

# Splits. Cmd+Ctrl avoids macOS (Cmd+H hide, Cmd+Shift+H hide others)
# and AeroSpace (Alt+hjkl) conflicts.
keybind = super+d=new_split:right
keybind = super+shift+d=new_split:down
keybind = super+ctrl+h=goto_split:left
keybind = super+ctrl+j=goto_split:down
keybind = super+ctrl+k=goto_split:up
keybind = super+ctrl+l=goto_split:right
keybind = super+ctrl+shift+h=resize_split:left,50
keybind = super+ctrl+shift+j=resize_split:down,50
keybind = super+ctrl+shift+k=resize_split:up,50
keybind = super+ctrl+shift+l=resize_split:right,50
keybind = super+ctrl+z=toggle_split_zoom
keybind = super+ctrl+e=equalize_splits
keybind = super+ctrl+w=close_surface
